enum Role {
  INDUSTRY
  CONSUMER
  ADMIN
}

model User {
  id               String            @id @default(uuid())
  name             String
  email            String            @unique
  role             Role              @default(CONSUMER)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  documents        Document[]
  complaints       Complaint[]
  complianceChecks ComplianceCheck[]
  chatSessions     ChatSession[]

  @@map("users")
}

model Standard {
  id             String          @id @default(uuid())
  standardNumber String          @unique
  title          String
  description    String?
  category       String?
  year           Int?
  status         String          @default("Active")
  sourceUrl      String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  certifications Certification[]

  @@map("standards")
}

model Product {
  id               String            @id @default(uuid())
  name             String
  category         String?
  description      String?
  manufacturer     String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  certifications   Certification[]
  complianceChecks ComplianceCheck[]
  complaints       Complaint[]

  @@map("products")
}

model Certification {
  id          String    @id @default(uuid())
  name        String
  description String?
  status      String    @default("Active")
  productId   String?
  standardId  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  product     Product?  @relation(fields: [productId], references: [id], onDelete: Cascade)
  standard    Standard? @relation(fields: [standardId], references: [id], onDelete: Cascade)

  @@map("certifications")
}

model ComplianceCheck {
  id        String   @id @default(uuid())
  userId    String?
  productId String?
  status    String   @default("PENDING")
  score     Float?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("compliance_checks")
}

model TestingLab {
  id        String   @id @default(uuid())
  name      String
  location  String?
  address   String?
  contact   String?
  website   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("testing_labs")
}

model Document {
  id        String   @id @default(uuid())
  userId    String?
  fileName  String
  fileType  String?
  fileUrl   String?
  status    String   @default("UPLOADED")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("documents")
}

model Complaint {
  id          String   @id @default(uuid())
  userId      String?
  productId   String?
  description String
  status      String   @default("SUBMITTED")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@map("complaints")
}

model ChatSession {
  id        String   @id @default(uuid())
  userId    String?
  mode      String   @default("consumer")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("chat_sessions")
}
