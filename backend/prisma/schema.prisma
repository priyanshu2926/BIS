generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  INDUSTRY
  CONSUMER
  ADMIN
}

enum ExtractionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ChatRole {
  USER
  ASSISTANT
  SYSTEM
}

model User {
  id               String            @id @default(uuid())
  name             String
  email            String            @unique
  role             Role              @default(CONSUMER)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  documents        Document[]
  complaints       Complaint[]
  complianceChecks ComplianceCheck[]
  chatSessions     ChatSession[]
  @@map("users")
}

// Core product and certification records used by the industry and consumer APIs.
model Standard {
  id             String          @id @default(uuid())
  standardNumber String          @unique
  title          String
  description    String?
  category       String?
  year           Int?
  status         String          @default("Active")
  sourceUrl      String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  certifications Certification[]
  @@map("standards")
}

model Product {
  id               String            @id @default(uuid())
  name             String
  category         String?
  description      String?
  manufacturer     String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  certifications   Certification[]
  complianceChecks ComplianceCheck[]
  complaints       Complaint[]
  @@map("products")
}

model Certification {
  id          String    @id @default(uuid())
  name        String
  description String?
  status      String    @default("Active")
  productId   String?
  standardId  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  product     Product?  @relation(fields: [productId], references: [id], onDelete: Cascade)
  standard    Standard? @relation(fields: [standardId], references: [id], onDelete: Cascade)
  @@map("certifications")
}

model ComplianceCheck {
  id        String   @id @default(uuid())
  userId    String?
  productId String?
  status    String   @default("PENDING")
  score     Float?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@map("compliance_checks")
}

model TestingLab {
  id        String   @id @default(uuid())
  name      String
  location  String?
  address   String?
  contact   String?
  website   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("testing_labs")
}

model Document {
  id        String   @id @default(uuid())
  userId    String?
  fileName  String
  fileType  String?
  fileUrl   String?
  status    String   @default("UPLOADED")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("documents")
}

model Complaint {
  id          String   @id @default(uuid())
  userId      String?
  productId   String?
  description String
  status      String   @default("SUBMITTED")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  @@map("complaints")
}

// Legacy lightweight chat records retained for the /chat resource API.
model ChatSession {
  id        String   @id @default(uuid())
  userId    String?
  mode      String   @default("consumer")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("chat_sessions")
}

// Knowledge-base models map to the Phase 2 tables without colliding with Standard above.
model KnowledgeStandard {
  id        String             @id @default(uuid())
  number    String             @unique
  title     String
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  documents StandardDocument[]
  @@map("Standard")
  @@index([title])
}

model StandardDocument {
  id               String            @id @default(uuid())
  standardId       String
  fileName         String
  fileType         String
  filePath         String
  sourceUrl        String?
  documentVersion  String?
  pageCount        Int?
  extractionStatus ExtractionStatus  @default(PENDING)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  standard         KnowledgeStandard @relation(fields: [standardId], references: [id], onDelete: Cascade)
  chunks           StandardChunk[]
  @@map("StandardDocument")
  @@index([standardId])
  @@index([extractionStatus])
}

model StandardChunk {
  id           String           @id @default(uuid())
  documentId   String
  chunkIndex   Int
  content      String
  pageNumber   Int
  sectionTitle String?
  metadata     Json
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  document     StandardDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  @@map("StandardChunk")
  @@unique([documentId, chunkIndex])
  @@index([documentId, pageNumber])
  @@index([sectionTitle])
}

// Persistent assistant history, separate from the legacy /chat resource model.
model AssistantSession {
  id        String             @id @default(uuid())
  title     String             @default("New Conversation")
  mode      String             @default("industry")
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  messages  AssistantMessage[]
  @@map("ChatSession")
  @@index([mode])
  @@index([createdAt])
}

model AssistantMessage {
  id        String           @id @default(uuid())
  sessionId String
  role      ChatRole
  content   String
  metadata  Json?
  createdAt DateTime         @default(now())
  session   AssistantSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  @@map("ChatMessage")
  @@index([sessionId, createdAt])
}
